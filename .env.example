# LastEcho Email Dispatcher Configuration (Optional - For automated Gmail delivery)
# 
# HOW TO GET A GMAIL APP PASSWORD (Takes 1 minute):
# 1. Open https://myaccount.google.com/security
# 2. Ensure 2-Step Verification is active.
# 3. Search for "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Name it "LastEcho", click Create.
# 5. Copy the 16-character password (without spaces) to EMAIL_PASS below.

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Port & Application URL
PORT=5000
APP_URL=http://localhost:5000
